NODE_ENV=development
PORT=4000
INTERNAL_PORT=4000
EXTERNAL_PORT=4000

DATABASE_USER=financeiro
DATABASE_PASS=financeiro
DATABASE_NAME=financeiro
DB_PORT=5432
# Fora do Docker (a BD do compose está exposta na 5434)
DATABASE_URL=postgresql://financeiro:financeiro@localhost:5434/financeiro

# Obrigatório, mínimo 32 caracteres: openssl rand -base64 48
JWT_SECRET=
# A duração da sessão é o parâmetro do sistema auth.sessionDays (painel de administração)

# Super administrador criado pelo `yarn seed` (se ainda não existir). Mude a palavra-passe em produção.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@financas.local
ADMIN_PASSWORD=admin12345

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# Fuso usado para "hoje" e "mês corrente"
APP_TZ=Africa/Maputo

# Email (alertas, resumo semanal, relatório mensal). Sem SMTP_HOST os emails só são registados no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Finanças <no-reply@exemplo.com>"

# Assistente (Claude). Sem chave, o assistente funciona em modo offline: responde a partir do manual e das FAQ.
# O modelo, o esforço, o limite diário e o liga/desliga são parâmetros do sistema (grupo "assistant").
ANTHROPIC_API_KEY=
